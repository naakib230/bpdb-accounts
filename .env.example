APP_NAME="BPDB Accounts Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Asia/Dhaka"
APP_URL=http://localhost:1972
WEB_PORT=1972

APP_LOCALE=bn
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=bn_BD

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (PostgreSQL 17)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bpdb_accounts
DB_USERNAME=bpdb_admin
DB_PASSWORD=secret

# Docker Compose Database Settings
DOCKER_DB_HOST=db
DOCKER_DB_PORT=5432
DB_PUBLISHED_PORT=5438

# Session & Cache Settings
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=bpdb_accounts_cache

# Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Mail Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@bpdb.gov.bd"
MAIL_FROM_NAME="${APP_NAME}"

# BPDB ERP OData Integration
ERP_ODATA_ENDPOINT="http://bc1.bdpowersectorerp.com:7048/POWERDIVBCONE/ODataV4/Company('BPDB')/Employee_Card"
ERP_ODATA_USERNAME=""
ERP_ODATA_PASSWORD=""
ERP_ODATA_TIMEOUT=15
